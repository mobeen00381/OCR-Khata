# ── SteelKhata AI ──────────────────────────────────────────────
# Dual OCR: Qwen3.8 Flash primary + GLM-5.3 Flash fallback.
# Without these keys the app uses a realistic mock parser so the UI never breaks.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_ESCALATION_MODEL=qwen3-vl-plus

GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=b80729476b744a13993c36e7145845c3.5uQ3qILFCexcsNNw

# Per-provider request timeout in milliseconds (5000–120000)
OCR_TIMEOUT_MS=28000

# Supabase (optional for this local-demo build; schema is in supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo owner PIN for Close & Lock Day (change for production)
NEXT_PUBLIC_DEMO_OWNER_PIN=1234
