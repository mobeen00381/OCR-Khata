# ── SteelKhata AI ──────────────────────────────────────────────
# Real multimodal OCR order: glm-4.6v → glm-4.6v-flash → qwen-vl-plus.
# Without any OCR key the scanner uses a clearly labelled mock fallback.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_PRIMARY_MODEL=glm-4.6v
GLM_FALLBACK_MODEL=glm-4.6v-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus
QWEN_ESCALATION_MODEL=qwen-vl-plus

# Per-provider request timeout in milliseconds (5000–120000)
OCR_TIMEOUT_MS=30000

# Supabase persistence. Server-side reads/writes use the service role; never
# expose that key to the browser. The anon key is only for the optional client
# storage/auth helper.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The workspace API targets this business when set, otherwise the oldest business.
STEELKHATA_BUSINESS_ID=
# Reuse an existing auth user instead of auto-creating a demo owner.
STEELKHATA_OWNER_ID=

# Demo owner PIN for Close & Lock Day (change for production)
NEXT_PUBLIC_DEMO_OWNER_PIN=1234
